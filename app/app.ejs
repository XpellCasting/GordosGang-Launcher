<html lang="es" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="utf-8" http-equiv="Content-Security-Policy" content="script-src 'self' 'sha256-In6B8teKZQll5heMl9bS7CESTbGvuAt3VVV86BUQBDk='"/>
    <title><%= lang('app.title') %></title>
    <script src="./assets/js/scripts/uicore.js"></script>
    <script src="./assets/js/scripts/uibinder.js"></script>
    <link type="text/css" rel="stylesheet" href="./assets/css/launcher.css">
    <style>
        body {
            background-color: #0b0820;
            -webkit-user-select: none;
        }
        #main {
            display: none;
            height: calc(100% - 22px);
            width: 100%;
            position: absolute;
            z-index: 10;
        }
        /* Night shade over the background art. Lives outside #main so it is
           already in place while the loading screen is still up, instead of
           snapping in once the main UI is revealed. It only deepens the lake
           and the top sky, keeping the painted logo at full strength. */
        #backdropShade {
            position: fixed;
            left: 0;
            right: 0;
            top: 22px;
            bottom: 0;
            z-index: 5;
            pointer-events: none;
            background:
                linear-gradient(to top, rgba(9, 6, 28, 0.88) 0%, rgba(9, 6, 28, 0.35) 24%, rgba(9, 6, 28, 0) 42%),
                linear-gradient(to bottom, rgba(9, 6, 28, 0.45) 0%, rgba(9, 6, 28, 0) 14%);
        }
        #main[overlay] {
            opacity: 0.45;
        }
    </style>
</head>
<body>
    <div id="backdropShade" aria-hidden="true"></div>
    <%- include('frame') %>
    <div id="main">
        <%- include('login') %>
        <%- include('waiting') %>
        <%- include('loginOptions') %>
        <%- include('settings') %>
        <%- include('landing') %>
    </div>
    <%- include('overlay') %>
    <div id="loadingContainer">
        <div id="loadingContent">
            <div id="startupLoadingTrack" role="progressbar" aria-label="<%= lang('app.loadingLabel') %>" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" style="--startup-progress: 0%;">
                <div id="startupLoadingFill" aria-hidden="true"></div>
            </div>
            <div id="startupLoadingCaption">
                <span class="ggLoader" aria-hidden="true"><i></i><i></i><i></i></span>
                <p id="startupLoadingStatus" aria-live="polite"></p>
            </div>
        </div>
    </div>
</body>
</html>
