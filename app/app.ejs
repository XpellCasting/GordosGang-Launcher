<html lang="es" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="utf-8" http-equiv="Content-Security-Policy" content="script-src 'self' 'sha256-In6B8teKZQll5heMl9bS7CESTbGvuAt3VVV86BUQBDk='"/>
    <title><%= lang('app.title') %></title>
    <script src="./assets/js/scripts/uicore.js"></script>
    <script src="./assets/js/scripts/uibinder.js"></script>
    <link type="text/css" rel="stylesheet" href="./assets/css/launcher.css">
    <style>
        body {
            background-color: #08090d;
            -webkit-user-select: none;
        }
        #main {
            display: none;
            height: calc(100% - 22px);
            background: linear-gradient(to top, rgba(0, 0, 0, 0.75) 0%, rgba(0, 0, 0, 0) 100%);
            width: 100%;
            position: absolute;
            z-index: 10;
        }
        #main[overlay] {
            filter: blur(3px) contrast(0.9) brightness(1.0);
        }
    </style>
</head>
<body>
    <video id="launcherBackgroundVideo" autoplay muted loop playsinline preload="metadata" poster="assets/images/backgrounds/utgc-background.png" aria-hidden="true" tabindex="-1">
        <source src="utgc-media://background/video.mp4" type="video/mp4">
    </video>
    <%- include('frame') %>
    <div id="main">
        <%- include('login') %>
        <%- include('waiting') %>
        <%- include('loginOptions') %>
        <%- include('settings') %>
        <%- include('landing') %>
    </div>
    <%- include('overlay') %>
    <div id="loadingContainer">
        <div id="loadingContent">
            <div id="startupLoadingTrack" role="progressbar" aria-label="Carga de UTGC Launcher" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" style="--startup-progress: 0%;">
                <img id="startupLoadingBase" src="assets/images/UTGC.svg" alt="" aria-hidden="true">
                <img id="startupLoadingFill" src="assets/images/UTGC.svg" alt="" aria-hidden="true">
            </div>
        </div>
    </div>
</body>
</html>
