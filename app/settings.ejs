            <div class="settingsTabHeader">
                <span class="settingsTabHeaderText"><%- lang('settings.launcherUpdatesHeaderText') %></span>
                <span class="settingsTabHeaderDesc"><%- lang('settings.launcherUpdatesHeaderDesc') %></span>
            </div>
