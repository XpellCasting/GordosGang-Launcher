<div id="landingContainer" style="display: none;">
    <div id="upper">
        <div id="left">
            <div id="image_seal_container" role="button" tabindex="0">
                <span class="updateBadgeDot" aria-hidden="true"></span>
                <span id="updateAvailableTooltip"><%- lang('landing.updateAvailableTooltip') %></span>
            </div>
        </div>
        <div id="content">
        </div>
        <div id="right">
            <div id="rightContainer">
                <div id="mediaContent">
                    <div id="internalMedia">
                        <div class="mediaContainer" id="settingsMediaContainer">
                            <button class="mediaButton" id="settingsMediaButton">
                                <svg class="tabler-icon mediaSVG" aria-hidden="true" focusable="false" id="settingsSVG"
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M10.325 4.317c.426 -1.756 2.924 -1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543 -.94 3.31 .826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756 .426 1.756 2.924 0 3.35a1.724 1.724 0 0 0 -1.066 2.573c.94 1.543 -.826 3.31 -2.37 2.37a1.724 1.724 0 0 0 -2.572 1.065c-.426 1.756 -2.924 1.756 -3.35 0a1.724 1.724 0 0 0 -2.573 -1.066c-1.543 .94 -3.31 -.826 -2.37 -2.37a1.724 1.724 0 0 0 -1.065 -2.572c-1.756 -.426 -1.756 -2.924 0 -3.35a1.724 1.724 0 0 0 1.066 -2.573c-.94 -1.543 .826 -3.31 2.37 -2.37c1 .608 2.296 .07 2.572 -1.065" />
  <path d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0" />
</svg>
                                <div id="settingsTooltip"><%- lang('landing.settingsTooltip') %></div>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="lower">
        <div id="left">
            <div class="bot_wrapper">
                <section id="serverCard" data-state="checking" aria-live="polite">
                    <div id="serverCardHead">
                        <img id="serverCardIcon" src="./assets/images/AppIcon.png" alt="" width="44" height="44">
                        <div id="serverCardTitle">
                            <span id="serverCardName"><%- lang('landing.serverStatus') %></span>
                            <span id="serverCardStatus">
                                <span id="serverCardDot" aria-hidden="true"></span>
                                <span id="serverCardStatusText"><%- lang('landing.serverCardChecking') %></span>
                                <span id="serverCardLatency"></span>
                            </span>
                        </div>
                    </div>
                    <p id="serverCardMotd"></p>
                    <div id="serverCardPlayers">
                        <div id="serverCardMeter" aria-hidden="true"></div>
                        <span id="serverCardPlayerText"></span>
                        <div id="serverCardHeads"></div>
                    </div>
                    <div id="serverCardFoot">
                        <span id="serverCardVersion"></span>
                        <button id="serverCardAddress" type="button" title="<%- lang('landing.serverCardCopy') %>">
                            <span id="serverCardAddressText"></span>
                            <svg class="tabler-icon" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 9.667a2.667 2.667 0 0 1 2.667 -2.667h8.666a2.667 2.667 0 0 1 2.667 2.667v8.666a2.667 2.667 0 0 1 -2.667 2.667h-8.666a2.667 2.667 0 0 1 -2.667 -2.667z" /><path d="M4.012 16.737a2.005 2.005 0 0 1 -1.012 -1.737v-10c0 -1.1 .9 -2 2 -2h10c.75 0 1.158 .385 1.5 1" /></svg>
                        </button>
                    </div>
                </section>
            </div>
        </div>
        <div id="center">
            <div class="bot_wrapper">
                <div id="content">
                    <button id="newsButton">
                        <!--<img src="assets/images/icons/arrow.svg" id="newsButtonSVG"/>-->
                        <svg class="tabler-icon arrowLine" aria-hidden="true" focusable="false" id="newsButtonSVG"
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M6 15l6 -6l6 6" />
</svg>
                        <span id="newsButtonText"><%- lang('landing.newsButton') %><span id="newsButtonAlert" style="display: none;"></span></span>
                    </button>
                </div>
            </div>
        </div>
        <div id="right">
            <div class="bot_wrapper launchPanel">
                <div id="user_content">
                    <div id="avatarStage">
                        <div id="avatarContainer" aria-hidden="true"></div>
                        <button id="avatarOverlay" type="button" aria-label="<%- lang('landing.usernameEditButton') %>"></button>
                    </div>
                    <span id="user_text"><%- lang('landing.usernamePlaceholder') %></span>
                </div>
                <div id="launch_content">
                    <button id="launch_button"><svg class="tabler-icon launchIcon" aria-hidden="true" focusable="false"
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M7 4v16l13 -8l-13 -8" />
</svg><span class="launchLabel"><%- lang('landing.launchButton') %></span></button>
                    <div class="bot_divider"></div>
                    <button id="server_selection_button" class="bot_label"><%- lang('landing.launchButtonPlaceholder') %></button>
                </div>
                <div id="launch_details">
                    <div id="launch_details_left">
                        <span id="launch_progress_label">0%</span>
                        <div class="bot_divider"></div>
                    </div>
                    <div id="launch_details_right">
                        <progress id="launch_progress" value="22" max="100"></progress>
                        <span id="launch_details_text" class="bot_label"><%- lang('landing.launchDetails') %></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="newsContainer">
        <section id="newsPanel" aria-label="<%- lang('landing.newsButton') %>">
            <div id="newsContent" article="-1" style="display: none;">
                <header id="newsHeader">
                    <div id="newsHeading">
                        <div id="newsKicker">
                            <img id="newsKickerIcon" src="./assets/images/AppIcon.png" alt="" width="20" height="20">
                            <span><%- lang('landing.newsButton') %></span>
                            <span class="newsKickerSep" aria-hidden="true"></span>
                            <time id="newsArticleDate"></time>
                        </div>
                        <h2 id="newsTitleContainer"><a id="newsArticleTitle" href="#"></a></h2>
                        <span id="newsArticleAuthor"></span>
                    </div>
                    <nav id="newsNavigationContainer">
                        <button id="newsNavigateLeft" type="button" aria-label="<%- lang('landing.newsPrevious') %>">
                            <svg class="tabler-icon" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6l6 6" /></svg>
                        </button>
                        <span id="newsNavigationStatus"><%- lang('landing.newsNavigationStatus', { currentPage: 1, totalPages: 1 }) %></span>
                        <button id="newsNavigateRight" type="button" aria-label="<%- lang('landing.newsNext') %>">
                            <svg class="tabler-icon" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6l-6 6" /></svg>
                        </button>
                    </nav>
                </header>
                <div id="newsArticleContainer">
                    <div id="newsArticleContentScrollable">
                        <!-- Article Content -->
                    </div>
                </div>
                <footer id="newsFooter">
                    <a id="newsArticleLink" href="#"><%- lang('landing.newsOpenLink') %>
                        <svg class="tabler-icon" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6" /><path d="M11 13l9 -9" /><path d="M15 4h5v5" /></svg>
                    </a>
                </footer>
            </div>
            <div id="newsErrorContainer">
                <div id="newsErrorLoading">
                    <span class="ggLoader" aria-hidden="true"><i></i><i></i><i></i></span>
                    <span id="nELoadSpan" class="newsErrorContent"><%- lang('landing.newsErrorLoadSpan') %></span>
                </div>
                <div id="newsErrorFailed" style="display: none;">
                    <span id="nEFailedSpan" class="newsErrorContent"><%- lang('landing.newsErrorFailedSpan') %></span>
                    <button id="newsErrorRetry" type="button"><%- lang('landing.newsErrorRetryButton') %></button>
                </div>
                <div id="newsErrorNone" style="display: none;">
                    <span id="nENoneSpan" class="newsErrorContent"><%- lang('landing.newsErrorNoneSpan') %></span>
                </div>
            </div>
        </section>
    </div>
    <script src="./assets/js/scripts/landing.js"></script>
</div>
